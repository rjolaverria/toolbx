{
  "name": "@toolbx/cli",
  "version": "0.1.4",
  "description": "Local MCP gateway — configure your MCP servers once and connect every MCP client (Claude, Codex, OpenCode) to one place.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gateway",
    "proxy",
    "claude",
    "codex",
    "opencode",
    "cli",
    "ai-tools"
  ],
  "homepage": "https://github.com/rjolaverria/toolbx#readme",
  "bugs": {
    "url": "https://github.com/rjolaverria/toolbx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rjolaverria/toolbx.git",
    "directory": "apps/cli"
  },
  "license": "MIT",
  "author": "rjolaverria",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.*",
    "!dist/**/__fixtures__/**"
  ],
  "bin": {
    "tlbx": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.7.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run -c ../../vitest.integration.config.ts"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@toolbx/core": "workspace:^",
    "@toolbx/custom-tools": "workspace:^",
    "@toolbx/mcp-gateway": "workspace:^",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "latest",
    "typescript": "latest"
  }
}
