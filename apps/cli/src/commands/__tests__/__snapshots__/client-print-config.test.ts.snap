  "mcpServers": {
    "toolbx": {
      "url": "http://127.0.0.1:7331/mcp"
    }
  }
}
\`\`\`
"
`;

exports[`runClientPrintConfig > default friendly output for generic/stdio contains an explanation and a fenced code block 1`] = `
