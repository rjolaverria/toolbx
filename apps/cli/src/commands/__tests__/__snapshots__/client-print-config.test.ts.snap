\`\`\`json
{
  "mcpServers": {
    "toolbx": {
      "command": "npx",
      "args": [
        "-y",
        "@toolbx/cli",
        "serve",
        "--stdio"
      ]
    }
  }
}
\`\`\`
"
`;

