{
  "name": "@toolbx/core",
  "version": "0.1.5",
  "description": "Shared core of Toolbx (the local MCP gateway): config, server registry, proxy, namespacing, progressive disclosure, and auth.",
  "homepage": "https://github.com/rjolaverria/toolbx#readme",
  "bugs": {
    "url": "https://github.com/rjolaverria/toolbx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rjolaverria/toolbx.git",
    "directory": "packages/core"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.*",
    "!dist/**/__fixtures__/**"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "jsonc-parser": "^3.3.1",
    "open": "^10.1.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "smol-toml": "^1.6.1",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  }
}
