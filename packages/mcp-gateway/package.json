{
  "name": "@toolbx/mcp-gateway",
  "version": "0.1.4",
  "description": "MCP protocol layer for Toolbx (the local MCP gateway): an MCP server for downstream clients and an MCP client for upstream servers.",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.*",
    "!dist/**/__fixtures__/**"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@toolbx/core": "workspace:^",
    "@toolbx/custom-tools": "workspace:^",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  }
}
