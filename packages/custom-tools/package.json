{
  "name": "@toolbx/custom-tools",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.*",
    "!dist/**/__fixtures__/**"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=22.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.54",
    "@cfworker/json-schema": "^4.1.1",
    "@toolbx/core": "workspace:^",
    "typescript": "^6.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  }
}
